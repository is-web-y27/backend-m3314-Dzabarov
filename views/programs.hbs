<!DOCTYPE html>
<html lang="ru">
<head>
  <title>{{title}}</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{> bundles}}
</head>
<body>
{{> header}}

<main class="main">
  <section class="section">
    <h2>Программы</h2>
    <p>Три направления лагеря: походы, спортивная подготовка и медиапрактика.</p>

    <div class="entity-grid">
      {{#each programs}}
        <article class="entity-card">
          <h3 class="article__title">{{title}}</h3>
          <p>{{description}}</p>
          <p><strong>Длительность:</strong> {{duration}}</p>
          <p><strong>Стоимость:</strong> {{price}}</p>
        </article>
      {{/each}}
    </div>
  </section>
</main>

{{> footer}}
</body>
</html>
