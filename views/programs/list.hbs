{{> layoutStart}}
<section class="section">
  <div class="page-actions">
    <div>
      <h2>Программы</h2>
      <p>Коллекция программ из базы данных.</p>
    </div>
    <a class="button" href="/programs/add">Добавить программу</a>
  </div>

  {{#if programs.length}}
    <div class="entity-grid">
      {{#each programs}}
        <article class="entity-card">
          <h3>{{title}}</h3>
          <p>{{description}}</p>
          <dl class="details-list">
            <div><dt>Формат</dt><dd>{{format}}</dd></div>
            <div><dt>Сложность</dt><dd>{{difficulty}}</dd></div>
            <div><dt>Дней</dt><dd>{{durationDays}}</dd></div>
            <div><dt>Цена</dt><dd>{{price}}</dd></div>
          </dl>
          <div class="card-actions">
            <a class="button" href="/programs/{{id}}">Открыть</a>
            <a class="button button--secondary" href="/programs/{{id}}/edit">Изменить</a>
            <form action="/programs/{{id}}/delete" method="post">
              <button class="button button--danger" type="submit">Удалить</button>
            </form>
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p class="empty-state">Программ пока нет.</p>
  {{/if}}
</section>
{{> layoutEnd}}
