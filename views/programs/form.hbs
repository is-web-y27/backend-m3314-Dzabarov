{{> layoutStart}}
<section class="section">
  <h2>{{formTitle}}</h2>
  <form class="entity-form" action="{{action}}" method="post">
    <label class="form-row">
      <span>Название</span>
      <input class="input" type="text" name="title" value="{{program.title}}" required>
    </label>
    <label class="form-row">
      <span>Описание</span>
      <textarea class="textarea" name="description" rows="5" required>{{program.description}}</textarea>
    </label>
    <label class="form-row">
      <span>Формат</span>
      <input class="input" type="text" name="format" value="{{program.format}}" required>
    </label>
    <label class="form-row">
      <span>Сложность</span>
      <input class="input" type="text" name="difficulty" value="{{program.difficulty}}" required>
    </label>
    <label class="form-row">
      <span>Длительность</span>
      <input class="input" type="number" name="durationDays" value="{{program.durationDays}}" min="1" required>
    </label>
    <label class="form-row">
      <span>Стоимость</span>
      <input class="input" type="number" step="0.01" name="price" value="{{program.price}}" min="0" required>
    </label>
    <label class="checkbox-row">
      <input type="checkbox" name="isActive" {{#if program.isActive}}checked{{/if}}>
      <span>Активная программа</span>
    </label>
    <div class="card-actions">
      <button class="button" type="submit">{{submitLabel}}</button>
      <a class="button button--secondary" href="/programs">Отмена</a>
    </div>
  </form>
</section>
{{> layoutEnd}}
